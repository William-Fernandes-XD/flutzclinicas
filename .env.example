# -----------------------------------------------------------------------------
# Flutz — modelo de variáveis de ambiente
# Copie para .env e substitua ALTERAR_AQUI. Não commite o .env real.
# -----------------------------------------------------------------------------

APP_NAME=Flutz
APP_ENV=development
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

COMPANY_NAME=UpVibe
COMPANY_URL=https://www.upvibe.blog.br/

SERVER_PORT=8080

# Frontend (variáveis públicas — prefixo VITE_)
VITE_API_URL=http://localhost:8080
VITE_SITE_URL=http://localhost:5173
VITE_APP_NAME=Flutz
VITE_COMPANY_NAME=UpVibe
VITE_COMPANY_URL=https://www.upvibe.blog.br/
VITE_CONTACT_EMAIL=contato@flutzclinicas.com.br
VITE_CONTACT_WHATSAPP=62981451856
VITE_INSTAGRAM_URL=https://www.instagram.com/flutzclinicas/

# Preços somente para exibição na landing. O valor oficial está na tabela plano.
VITE_PLANO_FLUTZ=R$ 149,90/mês

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=flutz
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=ALTERAR_AQUI

MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=ALTERAR_AQUI
MAIL_PASSWORD=ALTERAR_AQUI
MAIL_FROM=nao-responda@exemplo.com
MAIL_FROM_NAME=Flutz
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

JWT_SECRET=ALTERAR_AQUI_MINIMO_32_CARACTERES
JWT_EXPIRATION=86400000
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
MAX_LOGIN_ATTEMPTS=0
LOGIN_LOCK_INCREMENT_SECONDS=5

CORS_ALLOWED_ORIGINS=http://localhost:5173

INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@exemplo.com
INITIAL_ADMIN_PASSWORD=ALTERAR_AQUI

# Google Drive — imagens da página da clínica
# JSON da conta de serviço: backend/secrets/google-drive-service-account.json
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=backend/secrets/google-drive-service-account.json

# Mercado Pago — mensalidade da clínica (conta da plataforma Flutz)
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Mercado Pago OAuth Connect — clínicas vinculam a própria conta (sem colar token)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Deve ser idêntica à Redirect URI cadastrada no painel do Mercado Pago
MERCADOPAGO_REDIRECT_URI=
