FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL
ARG VITE_SITE_URL
ARG VITE_APP_NAME=Flutz
ARG VITE_COMPANY_NAME=UpVibe
ARG VITE_COMPANY_URL
ARG VITE_PLANO_BASICO
ARG VITE_PLANO_PROFISSIONAL
ARG VITE_PLANO_PREMIUM

ENV VITE_API_URL=$VITE_API_URL \
    VITE_SITE_URL=$VITE_SITE_URL \
    VITE_APP_NAME=$VITE_APP_NAME \
    VITE_COMPANY_NAME=$VITE_COMPANY_NAME \
    VITE_COMPANY_URL=$VITE_COMPANY_URL \
    VITE_PLANO_BASICO=$VITE_PLANO_BASICO \
    VITE_PLANO_PROFISSIONAL=$VITE_PLANO_PROFISSIONAL \
    VITE_PLANO_PREMIUM=$VITE_PLANO_PREMIUM

RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
