# -----------------------------------------------------------------------------
# Flutz — variáveis do AMBIENTE DE PRODUÇÃO (API em api.flutzclinicas.com.br)
# Configure no servidor/container da API. Não use este arquivo no Docker local.
# -----------------------------------------------------------------------------

APP_NAME=Flutz
APP_ENV=production
APP_URL=https://api.flutzclinicas.com.br
FRONTEND_URL=https://flutzclinicas.com.br

COMPANY_NAME=UpVibe
COMPANY_URL=https://www.upvibe.blog.br/

SERVER_PORT=8080

CORS_ALLOWED_ORIGINS=https://flutzclinicas.com.br,https://www.flutzclinicas.com.br

# Mercado Pago — mensalidade (credenciais de PRODUÇÃO da plataforma)
MERCADOPAGO_PUBLIC_KEY=ALTERAR_AQUI
MERCADOPAGO_ACCESS_TOKEN=ALTERAR_AQUI
MERCADOPAGO_WEBHOOK_SECRET=

# OAuth Connect — mesmo app de produção
MERCADOPAGO_CLIENT_ID=ALTERAR_AQUI
MERCADOPAGO_CLIENT_SECRET=ALTERAR_AQUI
# Obrigatório: igual à Redirect URL no painel MP
# Preferir a API direta (evita passar pelo proxy da Vercel no callback):
MERCADOPAGO_REDIRECT_URI=https://api.flutzclinicas.com.br/api/public/mercadopago/oauth/callback
# PKCE: deixe false (padrão) a menos que o app no painel tenha PKCE ligado
MERCADOPAGO_OAUTH_PKCE=false

# Alternativa (site + proxy Vercel):
# MERCADOPAGO_REDIRECT_URI=https://flutzclinicas.com.br/api/public/mercadopago/oauth/callback
