# Exemplo. Não versionar valores reais.
# kubectl create secret generic flutz-backend \
#   --from-literal=DATABASE_USERNAME=... \
#   --from-literal=DATABASE_PASSWORD=... \
#   --from-literal=JWT_SECRET=... \
#   --from-literal=MAIL_USERNAME=... \
#   --from-literal=MAIL_PASSWORD=... \
#   --from-literal=MAIL_FROM=... \
#   --from-literal=INITIAL_ADMIN_NAME=... \
#   --from-literal=INITIAL_ADMIN_EMAIL=... \
#   --from-literal=INITIAL_ADMIN_PASSWORD=... \
#   --from-literal=CORS_ALLOWED_ORIGINS=https://seu-dominio.vercel.app \
#   --from-literal=APP_URL=https://api.seu-dominio \
#   --from-literal=FRONTEND_URL=https://seu-dominio.vercel.app
apiVersion: v1
kind: Secret
metadata:
  name: flutz-backend
type: Opaque
stringData:
  DATABASE_USERNAME: ALTERAR_AQUI
  DATABASE_PASSWORD: ALTERAR_AQUI
  JWT_SECRET: ALTERAR_AQUI_MINIMO_32_CARACTERES
  MAIL_USERNAME: ALTERAR_AQUI
  MAIL_PASSWORD: ALTERAR_AQUI
  MAIL_FROM: nao-responda@exemplo.com
  INITIAL_ADMIN_NAME: Administrador
  INITIAL_ADMIN_EMAIL: admin@exemplo.com
  INITIAL_ADMIN_PASSWORD: ALTERAR_AQUI
  CORS_ALLOWED_ORIGINS: https://seu-frontend.exemplo
  APP_URL: https://api.exemplo
  FRONTEND_URL: https://seu-frontend.exemplo
